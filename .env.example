# Supabase — the same project as Au Peptide Labs. The sticker store only
# touches its own sticker_* tables (supabase/migrations/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Service role: required to place and look up orders.
SUPABASE_SECRET_KEY=

# Primary production origin, e.g. https://peelsupply.com.au
NEXT_PUBLIC_SITE_URL=

# Business identity (app/lib/business-identity.ts). Lines that would show
# these are left out while they are unset.
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_ABN=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Bank transfer details shown at checkout and on the order page.
NEXT_PUBLIC_BANK_TRANSFER_BANK_NAME=
NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_TRANSFER_BSB=
NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_NUMBER=

# Order emails via Resend (optional). Nothing is sent while either is unset.
# EMAIL_FROM must be on a domain verified in Resend for this store.
RESEND_API_KEY=
EMAIL_FROM=
# Where new-order alerts go.
ORDER_ALERT_EMAIL=

# Signs order-status links in emails (any long random string).
ORDER_STATUS_LINK_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/*.
CRON_SECRET=
